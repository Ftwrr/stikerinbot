# ==========================================
# KONFIGURASI UTAMA
# ==========================================
# Direktori penyimpanan sesi login WhatsApp
SESSION_DIR=session_auth

# Nomor Owner WhatsApp (bisa tunggal, pisah koma, atau format array JSON)
# Contoh tunggal: OWNER_NUMBER=628111111111
# Contoh multi/array: OWNER_NUMBER=628111111111,628222222222
OWNER_NUMBER=628111111111,628222222222

# API Key dari https://api.zansxart.me
ZANS_API_KEY=your_api_key_here

# ==========================================
# RATE LIMIT & ANTI-SPAM (Opsional)
# ==========================================
# Jeda delay eksekusi perintah di chat pribadi untuk Free User (dalam milidetik, default 5000 = 5 detik)
PC_DELAY_MS=5000

# Jeda cooldown antrean antar perintah per pengguna (dalam milidetik, default 1500 = 1.5 detik)
COMMAND_COOLDOWN_MS=1500
